# ============================================================================
# TUTORIAL/GUIDE FILES - Exclude from repository
# ============================================================================
QUICKSTART.md
PART1_COMPLETE.md
FILE_STRUCTURE.md
SETUP_GUIDE.md
GIT_SETUP.md
GIT_QUICK_REF.md
setup.sh
setup_files/


# ============================================================================
# DATA & MODELS - Exclude from repository (too large)
# ============================================================================
# Generated data
data/
*.db
*.sqlite
*.sqlite3

# Trained models
models/
*.pkl
*.joblib
*.h5
*.pt
*.pth

# Logs
logs/
*.log


# ============================================================================
# PYTHON - Standard Python gitignore
# ============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments — ALL common names
venv/
venv*/
env/
ENV/
env.bak/
venv.bak/
.venv/
mrsenv/
*env/
*_env/


# ============================================================================
# TOOLS & EDITORS
# ============================================================================
# PyCharm
.idea/

# VS Code
.vscode/

# Claude Code (AI assistant local settings — not project files)
.claude/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# pipenv
Pipfile.lock

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json


# ============================================================================
# OPERATING SYSTEM FILES
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~


# ============================================================================
# SECRETS & ENVIRONMENT VARIABLES
# ============================================================================
# Never commit files with real credentials
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json


# ============================================================================
# PROJECT SPECIFIC
# ============================================================================
# Temporary files
tmp/
temp/
*.tmp

# Cache files
.cache/
cache/

# Experiment outputs
experiments/
results/


# ============================================================================
# AIRFLOW
# ============================================================================
# Task logs are large and machine-specific
airflow/logs/*
!airflow/logs/.gitkeep

# Archive snapshots of trained models — too large to commit
models/archive/

# .env contains real API keys — NEVER commit it
# Use airflow/.env.example as the template (that IS committed)
airflow/.env


# ============================================================================
# KEEP THESE FILES (explicitly un-ignore)
# ============================================================================
!README.md
!requirements.txt
!src/
!.gitignore
!airflow/.env.example
