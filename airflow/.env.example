# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real API keys.

# ── Airflow ────────────────────────────────────────────────────────────────────
# On Linux/Mac: set to your UID: echo "AIRFLOW_UID=$(id -u)"
# On Windows with Docker Desktop: leave 50000
AIRFLOW_UID=50000

# ── Music API Keys ─────────────────────────────────────────────────────────────
# Both are FREE — no credit card required.
#
# 1. Last.fm API key
#    Register at: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# 2. Spotify API credentials
#    Register at: https://developer.spotify.com/dashboard
#    Create app → set Redirect URI to http://127.0.0.1
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
